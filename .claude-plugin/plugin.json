{
  "name": "criar-template-claude",
  "version": "2.0.0",
  "type": "plugin",
  "displayName": "Criar Template Claude SDD v2.0",
  "description": "Plugin profissional para criar projetos com Pipeline SDD completo (9 agentes) + Clean Architecture + automação via API Claude",
  "author": "Christian Anjos",
  "repository": "https://github.com/christiananjos/criar-template-claude",
  "license": "MIT",
  "keywords": [
    "sdd",
    "spec-driven-development",
    "clean-architecture",
    "automation",
    "multi-agent",
    "pipeline",
    "claude",
    "template"
  ],
  "commands": [
    {
      "name": "criar-template-claude",
      "displayName": "Criar Template Claude v2.0",
      "description": "Cria estrutura completa de projeto com Pipeline SDD (9 agentes), Clean Architecture e automação",
      "path": "commands/criar-template-claude.md"
    },
    {
      "name": "run-pipeline",
      "displayName": "Executar Pipeline SDD Automático",
      "description": "Executa o pipeline SDD automático com 9 agentes via API Claude",
      "path": "commands/run-pipeline.md"
    }
  ],
  "features": {
    "agents": 9,
    "documentation": 7,
    "automatedPipeline": true,
    "cleanArchitecture": true,
    "supportedStacks": [".NET", "React/Next.js", "Angular", "Full-stack"]
  },
  "requirements": {
    "python": ">=3.8",
    "node": ">=18.0.0",
    "anthropicApi": "required"
  },
  "capabilities": [
    "project-scaffolding",
    "pipeline-automation",
    "code-generation",
    "architecture-guidance",
    "quality-validation"
  ],
  "links": {
    "documentation": "https://github.com/christiananjos/criar-template-claude#readme",
    "issues": "https://github.com/christiananjos/criar-template-claude/issues",
    "releases": "https://github.com/christiananjos/criar-template-claude/releases"
  },
  "changelog": {
    "2.0.0": {
      "date": "2026-07-25",
      "changes": [
        "🤖 Adicionar sdd-pipeline-executor.py (orquestrador automático)",
        "📚 Documentação completa integrada (7 arquivos)",
        "🏗️ Clean Architecture pronta",
        "✅ 9 agentes especializados",
        "⚡ 87% mais rápido que versão anterior",
        "📊 Validação automática em cascata",
        "🔄 Totalmente integrado com API Claude",
        "📈 Relatórios detalhados"
      ]
    }
  }
}
